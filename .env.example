HOST=127.0.0.1
PORT=8787
SHOROH_GAME_ADDRESS=

# Choose one method. SFTP is used for the separate WorldHosts game instance.
SHOROH_GAME_DATA_DIR=
SHOROH_SFTP_HOST=
SHOROH_SFTP_PORT=2022
SHOROH_SFTP_USER=
SHOROH_SFTP_PASSWORD=
SHOROH_SFTP_FINGERPRINT=
SHOROH_SFTP_DATA_DIR=/cstrike/addons/amxmodx/data

# Optional MySQL copy for the public ban list.
SHOROH_BANS_MYSQL_HOST=
SHOROH_BANS_MYSQL_PORT=3306
SHOROH_BANS_MYSQL_DATABASE=
SHOROH_BANS_MYSQL_USER=
SHOROH_BANS_MYSQL_PASSWORD=
# Fill both only when the hosting provider uses a self-signed certificate.
SHOROH_BANS_MYSQL_TLS_CERT=
SHOROH_BANS_MYSQL_TLS_FINGERPRINT=

# Configure a merchant and HTTPS URL before turning on real payments.
SHOROH_SYNC_VIP=0
SHOROH_PUBLIC_ORIGIN=
SHOROH_SHOP_ID=
SHOROH_SHOP_KEY=
SHOROH_VIP_RUB=
